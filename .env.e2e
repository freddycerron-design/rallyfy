# Entorno de las pruebas e2e (vite --mode e2e). Tiene prioridad sobre .env.local,
# así las pruebas nunca apuntan al proyecto real: toda la API se simula con page.route.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=clave-de-prueba-e2e
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
VITE_REALTIME_PUBLICO=false
