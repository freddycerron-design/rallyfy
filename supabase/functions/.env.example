# Secretos de las Edge Functions. En la nube: `npm run supabase -- secrets set --env-file supabase/functions/.env`
# Clave secreta de prueba de Turnstile (siempre aprueba): 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Sal para el hash de IP del límite de frecuencia. Usa un valor aleatorio largo.
IP_HASH_SALT=
