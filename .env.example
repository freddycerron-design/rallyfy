# Copia este archivo como .env.local y completa los valores.

# Supabase: URL del proyecto y clave anon (pública). En local las imprime `npm run supabase -- status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile: clave de sitio (pública). La secreta va en los secretos de la Edge Function.
# Para desarrollo, la clave de prueba de Cloudflare siempre aprueba: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Estilo del mapa. Por defecto OpenFreeMap (gratis, sin clave). Para MapTiler o Stadia, pon la URL del estilo con la clave.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Tiempo real para el público. Ponlo en false para usar sondeo cada 30 s (plan B si se agotan las conexiones).
VITE_REALTIME_PUBLICO=true
